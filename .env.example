# 复制为 .env 后填写: cp .env.example .env

# ---------- 必填: DeepSeek API ----------
DEEPSEEK_API_KEY=你的API_KEY
DEEPSEEK_BASE_URL=你的API地址

# ---------- MongoDB (checkpoint + 沙箱注册 + 会话记录) ----------
# 本地 MongoDB 默认。需连远程实例 (39.100.100.28 已验证可连通) 时可改为:
# mongodb://root:123456@39.100.100.28:27017/?authSource=admin
MONGODB_URI=mongodb://root:111116@127.0.0.1:27017/?authSource=admin

# ---------- Memory v2 (MySQL，方案 memory-upgrade-plan.md) ----------
# Memory v2 rollout（21.1：代码部署 ≠ 功能启用；默认全关 = 预部署/完全关闭）
# 未启用任何 MEMORY_V2_* flag 时不需要 DSN；启用后 DSN 缺失/不可用则启动失败 (fail closed)
# MEMORY_MYSQL_DSN=mysql+asyncmy://USER:PASSWORD@127.0.0.1:3306/memory_v2
# MEMORY_MYSQL_POOL_SIZE=10
# MEMORY_MYSQL_POOL_MAX_OVERFLOW=10
# MEMORY_MYSQL_CONNECT_TIMEOUT=5
MEMORY_V2_WRITE_ENABLED=0
MEMORY_V2_READ_ENABLED=0
MEMORY_BACKGROUND_JOBS_ENABLED=0
MEMORY_SEMANTIC_RETRIEVAL_ENABLED=0
# Worker 模式（JOBS=1 前必须先配置，否则 job 无人消费）：
#   disabled  |  embedded（Web 进程内运行）  |  standalone（独立进程 python -m agent.memory.worker_runner）
MEMORY_WORKER_MODE=disabled
# 完整启用顺序（部署时显式覆盖，方案 21.1）：
# 1. 备份目标 MySQL，执行 Alembic upgrade，验证 DSN/health check/revision
# 2. MEMORY_V2_WRITE_ENABLED=1   （仅显式同步写入的预热状态）
# 3. MEMORY_V2_READ_ENABLED=1    （参与回答）
# 4. MEMORY_WORKER_MODE=embedded|standalone（先配 worker）
# 5. MEMORY_BACKGROUND_JOBS_ENABLED=1（自动抽取后台任务）
# 6. MEMORY_SEMANTIC_RETRIEVAL_ENABLED=1（按需）
# 非法组合（启动失败，21.2）：WRITE=0 且 JOBS=1；SEMANTIC=1 且 READ=0

# ---------- 可选: 其他模型供应商 ----------
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# ZHIPU_API_KEY=
# ZHIPU_BASE_URL=
